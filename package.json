{
  "name": "cozy-cat-apartment",
  "private": true,
  "workspaces": [
    "v1",
    "v2",
    "v3",
    "v4"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=v1 -- --host 0.0.0.0",
    "build": "npm run build --workspace=v1 && npm run build --workspace=v2 && npm run build --workspace=v3 && npm run build --workspace=v4 && node scripts/build-site.mjs",
    "preview": "vite preview --outDir dist --host 0.0.0.0",
    "test": "vitest run",
    "test:browser": "playwright test",
    "dev:v2": "npm run dev --workspace=v2 -- --host 0.0.0.0",
    "dev:v3": "npm run dev --workspace=v3 -- --host 0.0.0.0",
    "dev:v4": "npm run dev --workspace=v4 -- --host 0.0.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "vitest": "^3.2.4"
  }
}
